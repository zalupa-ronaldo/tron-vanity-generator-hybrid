#version 450

// Input: 0x41 || Keccak account bytes, packed into six little-endian words.
// Output: 25-byte payload+SHA256d checksum in seven little-endian words.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 1) readonly buffer Payloads {
    uint words[];
} payloads;
layout(std430, set = 0, binding = 2) writeonly buffer FullAddresses {
    uint words[];
} fulls;
layout(std430, set = 0, binding = 10) readonly buffer RuntimeParams {
    uint words[];
} runtime;
layout(push_constant) uniform Params {
    uint count;
} params;

const uint K[64] = uint[64](
    0x428a2f98u,0x71374491u,0xb5c0fbcfu,0xe9b5dba5u,0x3956c25bu,0x59f111f1u,0x923f82a4u,0xab1c5ed5u,
    0xd807aa98u,0x12835b01u,0x243185beu,0x550c7dc3u,0x72be5d74u,0x80deb1feu,0x9bdc06a7u,0xc19bf174u,
    0xe49b69c1u,0xefbe4786u,0x0fc19dc6u,0x240ca1ccu,0x2de92c6fu,0x4a7484aau,0x5cb0a9dcu,0x76f988dau,
    0x983e5152u,0xa831c66du,0xb00327c8u,0xbf597fc7u,0xc6e00bf3u,0xd5a79147u,0x06ca6351u,0x14292967u,
    0x27b70a85u,0x2e1b2138u,0x4d2c6dfcu,0x53380d13u,0x650a7354u,0x766a0abbu,0x81c2c92eu,0x92722c85u,
    0xa2bfe8a1u,0xa81a664bu,0xc24b8b70u,0xc76c51a3u,0xd192e819u,0xd6990624u,0xf40e3585u,0x106aa070u,
    0x19a4c116u,0x1e376c08u,0x2748774cu,0x34b0bcb5u,0x391c0cb3u,0x4ed8aa4au,0x5b9cca4fu,0x682e6ff3u,
    0x748f82eeu,0x78a5636fu,0x84c87814u,0x8cc70208u,0x90befffau,0xa4506cebu,0xbef9a3f7u,0xc67178f2u
);
const uint IV[8] = uint[8](
    0x6a09e667u,0xbb67ae85u,0x3c6ef372u,0xa54ff53au,
    0x510e527fu,0x9b05688cu,0x1f83d9abu,0x5be0cd19u
);

uint rotr(uint x, int n) { return (x >> n) | (x << (32 - n)); }

void sha256Short(in uint message[32], int length, out uint digest[32]) {
    uint state[8];
    for (int i = 0; i < 8; ++i) state[i] = IV[i];
    uint schedule[16];
    for (int i = 0; i < 16; ++i) {
        uint word = 0u;
        for (int j = 0; j < 4; ++j) {
            int pos = i * 4 + j;
            uint byteValue = pos < length ? message[pos] :
                (pos == length ? 0x80u :
                 (pos == 62 ? uint(length * 8) >> 8 :
                  (pos == 63 ? uint(length * 8) & 255u : 0u)));
            word = (word << 8) | byteValue;
        }
        schedule[i] = word;
    }
    uint a=state[0], b=state[1], c=state[2], d=state[3];
    uint e=state[4], f=state[5], g=state[6], h=state[7];
    for (int i = 0; i < 64; ++i) {
        int j = i & 15;
        if (i >= 16) {
            uint w15 = schedule[(j + 1) & 15];
            uint w2 = schedule[(j + 14) & 15];
            uint s0 = rotr(w15, 7) ^ rotr(w15, 18) ^ (w15 >> 3);
            uint s1 = rotr(w2, 17) ^ rotr(w2, 19) ^ (w2 >> 10);
            schedule[j] = schedule[j] + s0 + schedule[(j + 9) & 15] + s1;
        }
        uint big1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
        uint choose = (e & f) ^ (~e & g);
        uint t1 = h + big1 + choose + K[i] + schedule[j];
        uint big0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
        uint majority = (a & b) ^ (a & c) ^ (b & c);
        uint t2 = big0 + majority;
        h=g; g=f; f=e; e=d+t1; d=c; c=b; b=a; a=t1+t2;
    }
    state[0]+=a; state[1]+=b; state[2]+=c; state[3]+=d;
    state[4]+=e; state[5]+=f; state[6]+=g; state[7]+=h;
    for (int i = 0; i < 8; ++i) {
        digest[i*4] = state[i] >> 24;
        digest[i*4+1] = (state[i] >> 16) & 255u;
        digest[i*4+2] = (state[i] >> 8) & 255u;
        digest[i*4+3] = state[i] & 255u;
    }
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= runtime.words[0]) return;
    uint message[32];
    for (int i = 0; i < 32; ++i) message[i] = 0u;
    for (int i = 0; i < 21; ++i) {
        uint word = payloads.words[gid * 6u + uint(i / 4)];
        message[i] = (word >> (8 * (i % 4))) & 255u;
    }
    uint first[32], second[32];
    sha256Short(message, 21, first);
    sha256Short(first, 32, second);
    uint packed[7];
    for (int i = 0; i < 7; ++i) packed[i] = 0u;
    for (int i = 0; i < 25; ++i) {
        uint value = i < 21 ? message[i] : second[i - 21];
        packed[i / 4] |= value << (8 * (i % 4));
    }
    for (int i = 0; i < 7; ++i)
        fulls.words[gid * 7u + uint(i)] = packed[i];
}
