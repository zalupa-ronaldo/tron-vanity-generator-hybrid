#else
const uint FIELD_LIMBS = 10u;
#endif
#ifdef VULKAN_FIELD8_MODE

// Experimental 8x32 field representation.  RDNA exposes fast 32-bit integer
// lanes, while the reference 10x26 path relies heavily on uint64 arithmetic.
// Keep this variant compile-time selectable so the RX can decide from the
// complete wall profile rather than from shader instruction counts alone.
const uint FE_P_WORDS[8] = uint[8](
    0xfffffc2fu, 0xfffffffeu, 0xffffffffu, 0xffffffffu,
    0xffffffffu, 0xffffffffu, 0xffffffffu, 0xffffffffu);

Fe fePrime() {
    Fe p;
    for (int i = 0; i < 8; ++i) p.n[i] = FE_P_WORDS[i];
    return p;
}

bool feLess(Fe a, Fe b) {
    for (int i = 7; i >= 0; --i) {
        if (a.n[i] < b.n[i]) return true;
        if (a.n[i] > b.n[i]) return false;
    }
    return false;
}

uint feAddRaw(Fe a, Fe b, out Fe r) {
    uint carry = 0u;
    for (int i = 0; i < 8; ++i) {
        uint64_t sum = uint64_t(a.n[i]) + uint64_t(b.n[i]) + uint64_t(carry);
        r.n[i] = uint(sum);
        carry = uint(sum >> 32);
    }
    return carry;
}

uint feSubRaw(Fe a, Fe b, out Fe r) {
    uint borrow = 0u;
    for (int i = 0; i < 8; ++i) {
        uint64_t rhs = uint64_t(b.n[i]) + uint64_t(borrow);
        r.n[i] = uint(uint64_t(a.n[i]) - rhs);
        borrow = uint64_t(a.n[i]) < rhs ? 1u : 0u;
    }
    return borrow;
}

uint addWords16(inout uint words[16], uint dstOffset,
                uint source[16], uint sourceOffset) {
    uint carry = 0u;
    for (uint i = 0u; i < 8u; ++i) {
        uint64_t sum = uint64_t(words[dstOffset + i]) +
                       uint64_t(source[sourceOffset + i]) + uint64_t(carry);
        words[dstOffset + i] = uint(sum);
        carry = uint(sum >> 32);
    }
    return carry;
}

Fe feMul(Fe a, Fe b) {
    // Schoolbook 8x32 product.  The carry is propagated in base 2^32, so
    // every intermediate sum is bounded by 2^64-1.  Then fold the high half
    // with 2^256 == 0x1000003d1 (mod p).  Keep the complete folded value in a
    // few extra words: dropping the second fold's high carry is an easy way
    // to get rare, silent curve corruption.
    uint product[16];
    for (uint i = 0u; i < 16u; ++i) product[i] = 0u;
    for (uint i = 0u; i < 8u; ++i) {
        uint carry = 0u;
        for (uint j = 0u; j < 8u; ++j) {
            uint64_t uv = uint64_t(a.n[i]) * uint64_t(b.n[j]) +
                          uint64_t(product[i + j]) + uint64_t(carry);
            product[i + j] = uint(uv);
            carry = uint(uv >> 32);
        }
        for (uint j = i + 8u; j < 16u; ++j) {
            uint64_t uv = uint64_t(product[j]) + uint64_t(carry);
            product[j] = uint(uv);
            carry = uint(uv >> 32);
        }
    }

    uint words[20];
    for (uint i = 0u; i < 20u; ++i) words[i] = 0u;
    for (uint i = 0u; i < 8u; ++i) words[i] = product[i];

    // H * (0x3d1 + 2^32), with H = product[8..15].
    uint carry = 0u;
    for (uint i = 0u; i < 8u; ++i) {
        uint64_t uv = uint64_t(product[8u + i]) * uint64_t(0x3d1u) +
                      uint64_t(words[i]) + uint64_t(carry);
        words[i] = uint(uv);
        carry = uint(uv >> 32);
    }
    for (uint i = 8u; i < 20u; ++i) {
        uint64_t uv = uint64_t(words[i]) + uint64_t(carry);
        words[i] = uint(uv);
        carry = uint(uv >> 32);
    }
    carry = 0u;
    for (uint i = 0u; i < 8u; ++i) {
        uint64_t uv = uint64_t(product[8u + i]) + uint64_t(words[i + 1u]) +
                      uint64_t(carry);
        words[i + 1u] = uint(uv);
        carry = uint(uv >> 32);
    }
    for (uint i = 9u; i < 20u; ++i) {
        uint64_t uv = uint64_t(words[i]) + uint64_t(carry);
        words[i] = uint(uv);
        carry = uint(uv >> 32);
    }

    // Three fixed rounds are enough for a 512-bit product.  Each round reads
    // the high words before writing the low words, because the shifted term
    // overlaps the destination range.
    for (uint round = 0u; round < 3u; ++round) {
        uint high[12];
        for (uint i = 0u; i < 12u; ++i) {
            high[i] = words[8u + i];
            words[8u + i] = 0u;
        }
        carry = 0u;
        for (uint i = 0u; i < 12u; ++i) {
            uint64_t uv = uint64_t(high[i]) * uint64_t(0x3d1u) +
                          uint64_t(words[i]) + uint64_t(carry);
            words[i] = uint(uv);
            carry = uint(uv >> 32);
        }
        for (uint i = 12u; i < 20u; ++i) {
            uint64_t uv = uint64_t(words[i]) + uint64_t(carry);
            words[i] = uint(uv);
            carry = uint(uv >> 32);
        }
        carry = 0u;
        for (uint i = 0u; i < 12u; ++i) {
            uint64_t uv = uint64_t(high[i]) + uint64_t(words[i + 1u]) +
                          uint64_t(carry);
            words[i + 1u] = uint(uv);
            carry = uint(uv >> 32);
        }
        for (uint i = 13u; i < 20u; ++i) {
            uint64_t uv = uint64_t(words[i]) + uint64_t(carry);
            words[i] = uint(uv);
            carry = uint(uv >> 32);
        }
    }

    Fe result, prime = fePrime();
    for (int i = 0; i < 8; ++i) result.n[i] = words[i];
    for (uint i = 0u; i < 3u; ++i) {
        if (feLess(result, prime)) break;
        Fe reduced;
        feSubRaw(result, prime, reduced);
        result = reduced;
    }
    return result;
}

Fe feSqr(Fe a) { return feMul(a, a); }

Fe feInt(uint x) {
    Fe r;
    r.n[0] = x;
    for (int i = 1; i < 8; ++i) r.n[i] = 0u;
    return r;
}

Fe feAdd(Fe a, Fe b) {
    Fe r, prime = fePrime();
    uint carry = feAddRaw(a, b, r);
    if (carry != 0u || !feLess(r, prime)) feSubRaw(r, prime, r);
    return r;
}

Fe feMulInt(Fe a, uint x) {
    Fe r;
    uint64_t carry = 0ul;
    for (int i = 0; i < 8; ++i) {
        uint64_t product = uint64_t(a.n[i]) * uint64_t(x) + carry;
        r.n[i] = uint(product);
        carry = product >> 32;
    }
    uint64_t fold = carry * uint64_t(0x3d1u);
    Fe correction = feInt(uint(fold));
    correction.n[1] = uint(fold >> 32) + uint(carry);
    Fe sum, prime = fePrime();
    uint extra = feAddRaw(r, correction, sum);
    for (uint i = 0u; i < 4u; ++i) {
        if (extra == 0u && feLess(sum, prime)) break;
        feSubRaw(sum, prime, sum);
        extra = 0u;
    }
    return sum;
}

Fe feNegate(Fe a, uint m) {
    Fe r, prime = fePrime();
    bool zero = true;
    for (int i = 0; i < 8; ++i) zero = zero && (a.n[i] == 0u);
    if (zero) return a;
    feSubRaw(prime, a, r);
    return r;
}

Fe feHalf(Fe a) {
    Fe prime = fePrime(), t, r;
    uint high = 0u;
    if ((a.n[0] & 1u) != 0u) high = feAddRaw(a, prime, t);
    else t = a;
    for (int i = 7; i >= 0; --i) {
        r.n[i] = (t.n[i] >> 1) | (high << 31);
        high = t.n[i] & 1u;
    }
    return r;
}

Fe feNormalize(Fe r) {
    Fe prime = fePrime();
    for (uint i = 0u; i < 2u; ++i) {
        if (!feLess(r, prime)) feSubRaw(r, prime, r);
    }
    return r;
}

bool feZero(Fe a) {
    for (int i = 0; i < 8; ++i)
        if (a.n[i] != 0u) return false;
    return true;
}

Fe feSqrN(Fe a, int n) {
    for (int i = 0; i < n; ++i) a = feSqr(a);
    return a;
}

// Fermat inversion addition chain from the existing OpenCL/libsecp256k1 path.
Fe feInv(Fe a) {
    Fe x2 = feMul(feSqr(a), a);
    Fe x3 = feMul(feSqr(x2), a);
    Fe x6 = feMul(feSqrN(x3, 3), x3);
    Fe x9 = feMul(feSqrN(x6, 3), x3);
    Fe x11 = feMul(feSqrN(x9, 2), x2);
    Fe x22 = feMul(feSqrN(x11, 11), x11);
    Fe x44 = feMul(feSqrN(x22, 22), x22);
    Fe x88 = feMul(feSqrN(x44, 44), x44);
    Fe x176 = feMul(feSqrN(x88, 88), x88);
    Fe x220 = feMul(feSqrN(x176, 44), x44);
    Fe x223 = feMul(feSqrN(x220, 3), x3);
    Fe t = feMul(feSqrN(x223, 23), x22);
    t = feMul(feSqrN(t, 5), a);
    t = feMul(feSqrN(t, 3), x2);
    return feMul(feSqrN(t, 2), a);
}

uint sourceByte(uint index, uint byteIndex, bool fromTable) {
    uint address = index * 16u + byteIndex / 4u;
    uint word = fromTable ? table.words[address] :
        (params.curveMode == 0u ? inputs.words[address] : params.baseWords[address]);
    return (word >> (8u * (byteIndex & 3u))) & 255u;
}

Fe feFromBytes(uint index, uint start, bool fromTable) {
    uint a[32];
    for (uint i = 0u; i < 32u; ++i)
        a[i] = sourceByte(index, start + i, fromTable);
    Fe r;
    for (int i = 0; i < 8; ++i) {
        uint base = uint(31 - i * 4);
        r.n[i] = a[base] | (a[base - 1u] << 8) |
                 (a[base - 2u] << 16) | (a[base - 3u] << 24);
    }
    return r;
}

void feToBytes(Fe a, out uint bytes[32]) {
    for (int i = 0; i < 8; ++i) {
        uint word = a.n[7 - i];
        bytes[i * 4] = (word >> 24) & 255u;
        bytes[i * 4 + 1] = (word >> 16) & 255u;
        bytes[i * 4 + 2] = (word >> 8) & 255u;
        bytes[i * 4 + 3] = word & 255u;
    }
}

#else
const uint64_t MASK26 = 0x3fffffful;
const uint64_t R0 = 0x3d10ul;
const uint64_t R1 = 0x400ul;

// The 10x26 reduction is the same field representation as the OpenCL stage.
// Keep the multiply and square schedules explicit.  The former loop-based
// Vulkan port made every square go through a generic multiply and left the
// compiler to recover the convolution schedule from dynamically indexed
// arrays.  The OpenCL implementation already uses these fixed schedules; the
// explicit form gives the Vulkan compiler the same instruction-level shape.
Fe feMul(Fe a, Fe b) {
    const uint64_t M = 0x3fffffful;
    const uint64_t R0 = 0x3d10ul;
    const uint64_t R1 = 0x400ul;
    uint64_t c, d;
    uint64_t u0, u1, u2, u3, u4, u5, u6, u7, u8;
    uint t9, t0, t1, t2, t3, t4, t5, t6, t7;

    d = uint64_t(a.n[0]) * b.n[9] + uint64_t(a.n[1]) * b.n[8] +
        uint64_t(a.n[2]) * b.n[7] + uint64_t(a.n[3]) * b.n[6] +
        uint64_t(a.n[4]) * b.n[5] + uint64_t(a.n[5]) * b.n[4] +
        uint64_t(a.n[6]) * b.n[3] + uint64_t(a.n[7]) * b.n[2] +
        uint64_t(a.n[8]) * b.n[1] + uint64_t(a.n[9]) * b.n[0];
    t9 = uint(d & M); d >>= 26;

    c = uint64_t(a.n[0]) * b.n[0];
    d += uint64_t(a.n[1]) * b.n[9] + uint64_t(a.n[2]) * b.n[8] +
         uint64_t(a.n[3]) * b.n[7] + uint64_t(a.n[4]) * b.n[6] +
         uint64_t(a.n[5]) * b.n[5] + uint64_t(a.n[6]) * b.n[4] +
         uint64_t(a.n[7]) * b.n[3] + uint64_t(a.n[8]) * b.n[2] +
         uint64_t(a.n[9]) * b.n[1];
    u0 = d & M; d >>= 26; c += u0 * R0;
    t0 = uint(c & M); c >>= 26; c += u0 * R1;

    c += uint64_t(a.n[0]) * b.n[1] + uint64_t(a.n[1]) * b.n[0];
    d += uint64_t(a.n[2]) * b.n[9] + uint64_t(a.n[3]) * b.n[8] +
         uint64_t(a.n[4]) * b.n[7] + uint64_t(a.n[5]) * b.n[6] +
         uint64_t(a.n[6]) * b.n[5] + uint64_t(a.n[7]) * b.n[4] +
         uint64_t(a.n[8]) * b.n[3] + uint64_t(a.n[9]) * b.n[2];
    u1 = d & M; d >>= 26; c += u1 * R0;
    t1 = uint(c & M); c >>= 26; c += u1 * R1;

    c += uint64_t(a.n[0]) * b.n[2] + uint64_t(a.n[1]) * b.n[1] +
         uint64_t(a.n[2]) * b.n[0];
    d += uint64_t(a.n[3]) * b.n[9] + uint64_t(a.n[4]) * b.n[8] +
         uint64_t(a.n[5]) * b.n[7] + uint64_t(a.n[6]) * b.n[6] +
         uint64_t(a.n[7]) * b.n[5] + uint64_t(a.n[8]) * b.n[4] +
         uint64_t(a.n[9]) * b.n[3];
    u2 = d & M; d >>= 26; c += u2 * R0;
    t2 = uint(c & M); c >>= 26; c += u2 * R1;

    c += uint64_t(a.n[0]) * b.n[3] + uint64_t(a.n[1]) * b.n[2] +
         uint64_t(a.n[2]) * b.n[1] + uint64_t(a.n[3]) * b.n[0];
    d += uint64_t(a.n[4]) * b.n[9] + uint64_t(a.n[5]) * b.n[8] +
         uint64_t(a.n[6]) * b.n[7] + uint64_t(a.n[7]) * b.n[6] +
         uint64_t(a.n[8]) * b.n[5] + uint64_t(a.n[9]) * b.n[4];
    u3 = d & M; d >>= 26; c += u3 * R0;
    t3 = uint(c & M); c >>= 26; c += u3 * R1;

    c += uint64_t(a.n[0]) * b.n[4] + uint64_t(a.n[1]) * b.n[3] +
         uint64_t(a.n[2]) * b.n[2] + uint64_t(a.n[3]) * b.n[1] +
         uint64_t(a.n[4]) * b.n[0];
    d += uint64_t(a.n[5]) * b.n[9] + uint64_t(a.n[6]) * b.n[8] +
         uint64_t(a.n[7]) * b.n[7] + uint64_t(a.n[8]) * b.n[6] +
         uint64_t(a.n[9]) * b.n[5];
    u4 = d & M; d >>= 26; c += u4 * R0;
    t4 = uint(c & M); c >>= 26; c += u4 * R1;

    c += uint64_t(a.n[0]) * b.n[5] + uint64_t(a.n[1]) * b.n[4] +
         uint64_t(a.n[2]) * b.n[3] + uint64_t(a.n[3]) * b.n[2] +
         uint64_t(a.n[4]) * b.n[1] + uint64_t(a.n[5]) * b.n[0];
    d += uint64_t(a.n[6]) * b.n[9] + uint64_t(a.n[7]) * b.n[8] +
         uint64_t(a.n[8]) * b.n[7] + uint64_t(a.n[9]) * b.n[6];
    u5 = d & M; d >>= 26; c += u5 * R0;
    t5 = uint(c & M); c >>= 26; c += u5 * R1;

    c += uint64_t(a.n[0]) * b.n[6] + uint64_t(a.n[1]) * b.n[5] +
         uint64_t(a.n[2]) * b.n[4] + uint64_t(a.n[3]) * b.n[3] +
         uint64_t(a.n[4]) * b.n[2] + uint64_t(a.n[5]) * b.n[1] +
         uint64_t(a.n[6]) * b.n[0];
    d += uint64_t(a.n[7]) * b.n[9] + uint64_t(a.n[8]) * b.n[8] +
         uint64_t(a.n[9]) * b.n[7];
    u6 = d & M; d >>= 26; c += u6 * R0;
    t6 = uint(c & M); c >>= 26; c += u6 * R1;

    c += uint64_t(a.n[0]) * b.n[7] + uint64_t(a.n[1]) * b.n[6] +
         uint64_t(a.n[2]) * b.n[5] + uint64_t(a.n[3]) * b.n[4] +
         uint64_t(a.n[4]) * b.n[3] + uint64_t(a.n[5]) * b.n[2] +
         uint64_t(a.n[6]) * b.n[1] + uint64_t(a.n[7]) * b.n[0];
    d += uint64_t(a.n[8]) * b.n[9] + uint64_t(a.n[9]) * b.n[8];
    u7 = d & M; d >>= 26; c += u7 * R0;
    t7 = uint(c & M); c >>= 26; c += u7 * R1;

    c += uint64_t(a.n[0]) * b.n[8] + uint64_t(a.n[1]) * b.n[7] +
         uint64_t(a.n[2]) * b.n[6] + uint64_t(a.n[3]) * b.n[5] +
         uint64_t(a.n[4]) * b.n[4] + uint64_t(a.n[5]) * b.n[3] +
         uint64_t(a.n[6]) * b.n[2] + uint64_t(a.n[7]) * b.n[1] +
         uint64_t(a.n[8]) * b.n[0];
    d += uint64_t(a.n[9]) * b.n[9];
    u8 = d & M; d >>= 26; c += u8 * R0;

    Fe r;
    r.n[3] = t3; r.n[4] = t4; r.n[5] = t5; r.n[6] = t6; r.n[7] = t7;
    r.n[8] = uint(c & M); c >>= 26; c += u8 * R1;
    c += d * R0 + uint64_t(t9);
    r.n[9] = uint(c & (M >> 4)); c >>= 22; c += d * (R1 << 4);
    d = c * (R0 >> 4) + uint64_t(t0);
    r.n[0] = uint(d & M); d >>= 26;
    d += c * (R1 >> 4) + uint64_t(t1);
    r.n[1] = uint(d & M); d >>= 26;
    r.n[2] = uint(d + uint64_t(t2));
    return r;
}

Fe feSqr(Fe a) {
    const uint64_t M = 0x3fffffful;
    const uint64_t R0 = 0x3d10ul;
    const uint64_t R1 = 0x400ul;
    uint64_t c, d;
    uint64_t u0, u1, u2, u3, u4, u5, u6, u7, u8;
    uint t9, t0, t1, t2, t3, t4, t5, t6, t7;

    d = uint64_t(a.n[0] * 2u) * a.n[9] + uint64_t(a.n[1] * 2u) * a.n[8] +
        uint64_t(a.n[2] * 2u) * a.n[7] + uint64_t(a.n[3] * 2u) * a.n[6] +
        uint64_t(a.n[4] * 2u) * a.n[5];
    t9 = uint(d & M); d >>= 26;

    c = uint64_t(a.n[0]) * a.n[0];
    d += uint64_t(a.n[1] * 2u) * a.n[9] + uint64_t(a.n[2] * 2u) * a.n[8] +
         uint64_t(a.n[3] * 2u) * a.n[7] + uint64_t(a.n[4] * 2u) * a.n[6] +
         uint64_t(a.n[5]) * a.n[5];
    u0 = d & M; d >>= 26; c += u0 * R0;
    t0 = uint(c & M); c >>= 26; c += u0 * R1;

    c += uint64_t(a.n[0] * 2u) * a.n[1];
    d += uint64_t(a.n[2] * 2u) * a.n[9] + uint64_t(a.n[3] * 2u) * a.n[8] +
         uint64_t(a.n[4] * 2u) * a.n[7] + uint64_t(a.n[5] * 2u) * a.n[6];
    u1 = d & M; d >>= 26; c += u1 * R0;
    t1 = uint(c & M); c >>= 26; c += u1 * R1;

    c += uint64_t(a.n[0] * 2u) * a.n[2] + uint64_t(a.n[1]) * a.n[1];
    d += uint64_t(a.n[3] * 2u) * a.n[9] + uint64_t(a.n[4] * 2u) * a.n[8] +
         uint64_t(a.n[5] * 2u) * a.n[7] + uint64_t(a.n[6]) * a.n[6];
    u2 = d & M; d >>= 26; c += u2 * R0;
    t2 = uint(c & M); c >>= 26; c += u2 * R1;

    c += uint64_t(a.n[0] * 2u) * a.n[3] + uint64_t(a.n[1] * 2u) * a.n[2];
    d += uint64_t(a.n[4] * 2u) * a.n[9] + uint64_t(a.n[5] * 2u) * a.n[8] +
         uint64_t(a.n[6] * 2u) * a.n[7];
    u3 = d & M; d >>= 26; c += u3 * R0;
    t3 = uint(c & M); c >>= 26; c += u3 * R1;

    c += uint64_t(a.n[0] * 2u) * a.n[4] + uint64_t(a.n[1] * 2u) * a.n[3] +
         uint64_t(a.n[2]) * a.n[2];
    d += uint64_t(a.n[5] * 2u) * a.n[9] + uint64_t(a.n[6] * 2u) * a.n[8] +
         uint64_t(a.n[7]) * a.n[7];
    u4 = d & M; d >>= 26; c += u4 * R0;
    t4 = uint(c & M); c >>= 26; c += u4 * R1;

    c += uint64_t(a.n[0] * 2u) * a.n[5] + uint64_t(a.n[1] * 2u) * a.n[4] +
         uint64_t(a.n[2] * 2u) * a.n[3];
    d += uint64_t(a.n[6] * 2u) * a.n[9] + uint64_t(a.n[7] * 2u) * a.n[8];
    u5 = d & M; d >>= 26; c += u5 * R0;
    t5 = uint(c & M); c >>= 26; c += u5 * R1;

    c += uint64_t(a.n[0] * 2u) * a.n[6] + uint64_t(a.n[1] * 2u) * a.n[5] +
         uint64_t(a.n[2] * 2u) * a.n[4] + uint64_t(a.n[3]) * a.n[3];
    d += uint64_t(a.n[7] * 2u) * a.n[9] + uint64_t(a.n[8]) * a.n[8];
    u6 = d & M; d >>= 26; c += u6 * R0;
    t6 = uint(c & M); c >>= 26; c += u6 * R1;

    c += uint64_t(a.n[0] * 2u) * a.n[7] + uint64_t(a.n[1] * 2u) * a.n[6] +
         uint64_t(a.n[2] * 2u) * a.n[5] + uint64_t(a.n[3] * 2u) * a.n[4];
    d += uint64_t(a.n[8] * 2u) * a.n[9];
    u7 = d & M; d >>= 26; c += u7 * R0;
    t7 = uint(c & M); c >>= 26; c += u7 * R1;

    c += uint64_t(a.n[0] * 2u) * a.n[8] + uint64_t(a.n[1] * 2u) * a.n[7] +
         uint64_t(a.n[2] * 2u) * a.n[6] + uint64_t(a.n[3] * 2u) * a.n[5] +
         uint64_t(a.n[4]) * a.n[4];
    d += uint64_t(a.n[9]) * a.n[9];
    u8 = d & M; d >>= 26; c += u8 * R0;

    Fe r;
    r.n[3] = t3; r.n[4] = t4; r.n[5] = t5; r.n[6] = t6; r.n[7] = t7;
    r.n[8] = uint(c & M); c >>= 26; c += u8 * R1;
    c += d * R0 + uint64_t(t9);
    r.n[9] = uint(c & (M >> 4)); c >>= 22; c += d * (R1 << 4);
    d = c * (R0 >> 4) + uint64_t(t0);
    r.n[0] = uint(d & M); d >>= 26;
    d += c * (R1 >> 4) + uint64_t(t1);
    r.n[1] = uint(d & M); d >>= 26;
    r.n[2] = uint(d + uint64_t(t2));
    return r;
}
Fe feInt(uint x) {
    Fe r;
    r.n[0] = x;
    for (int i = 1; i < 10; ++i) r.n[i] = 0u;
    return r;
}
Fe feAdd(Fe a, Fe b) {
    for (int i = 0; i < 10; ++i) a.n[i] += b.n[i];
    return a;
}
Fe feMulInt(Fe a, uint x) {
    for (int i = 0; i < 10; ++i) a.n[i] *= x;
    return a;
}
Fe feNegate(Fe a, uint m) {
    Fe r;
    r.n[0] = 0x3fffc2fu * 2u * (m + 1u) - a.n[0];
    r.n[1] = 0x3ffffbfu * 2u * (m + 1u) - a.n[1];
    for (int i = 2; i < 9; ++i)
        r.n[i] = 0x3ffffffu * 2u * (m + 1u) - a.n[i];
    r.n[9] = 0x03fffffu * 2u * (m + 1u) - a.n[9];
    return r;
}
Fe feHalf(Fe r) {
    uint t[10];
    for (int i = 0; i < 10; ++i) t[i] = r.n[i];
    uint mask = uint(-int(t[0] & 1u)) >> 6;
    t[0] += 0x3fffc2fu & mask;
    t[1] += 0x3ffffbfu & mask;
    for (int i = 2; i < 9; ++i) t[i] += mask;
    t[9] += mask >> 4;
    for (int i = 0; i < 9; ++i)
        r.n[i] = (t[i] >> 1) + ((t[i + 1] & 1u) << 25);
    r.n[9] = t[9] >> 1;
    return r;
}

Fe feNormalize(Fe r) {
    uint t[10];
    for (int i = 0; i < 10; ++i) t[i] = r.n[i];
    uint x = t[9] >> 22;
    t[9] &= 0x03fffffu;
    t[0] += x * 0x3d1u;
    t[1] += x << 6;
    for (int i = 0; i < 9; ++i) {
        t[i + 1] += t[i] >> 26;
        t[i] &= 0x3ffffffu;
    }
    uint m = 0x3ffffffu;
    for (int i = 2; i <= 8; ++i) m &= t[i];
    x = (t[9] >> 22) | uint(
        t[9] == 0x03fffffu && m == 0x3ffffffu &&
        (t[1] + 0x40u + ((t[0] + 0x3d1u) >> 26)) > 0x3ffffffu);
    t[0] += x * 0x3d1u;
    t[1] += x << 6;
    for (int i = 0; i < 9; ++i) {
        t[i + 1] += t[i] >> 26;
        t[i] &= 0x3ffffffu;
    }
    t[9] &= 0x03fffffu;
    for (int i = 0; i < 10; ++i) r.n[i] = t[i];
    return r;
}
bool feZero(Fe a) {
    a = feNormalize(a);
    for (int i = 0; i < 10; ++i)
        if (a.n[i] != 0u) return false;
    return true;
}

Fe feSqrN(Fe a, int n) {
    for (int i = 0; i < n; ++i) a = feSqr(a);
    return a;
}
// Fermat inversion addition chain from the existing OpenCL/libsecp256k1 path.
Fe feInv(Fe a) {
    Fe x2 = feMul(feSqr(a), a);
    Fe x3 = feMul(feSqr(x2), a);
    Fe x6 = feMul(feSqrN(x3, 3), x3);
    Fe x9 = feMul(feSqrN(x6, 3), x3);
    Fe x11 = feMul(feSqrN(x9, 2), x2);
    Fe x22 = feMul(feSqrN(x11, 11), x11);
    Fe x44 = feMul(feSqrN(x22, 22), x22);
    Fe x88 = feMul(feSqrN(x44, 44), x44);
    Fe x176 = feMul(feSqrN(x88, 88), x88);
    Fe x220 = feMul(feSqrN(x176, 44), x44);
    Fe x223 = feMul(feSqrN(x220, 3), x3);
    Fe t = feMul(feSqrN(x223, 23), x22);
    t = feMul(feSqrN(t, 5), a);
    t = feMul(feSqrN(t, 3), x2);
    return feMul(feSqrN(t, 2), a);
}

uint sourceByte(uint index, uint byteIndex, bool fromTable) {
    uint address = index * 16u + byteIndex / 4u;
    uint word = fromTable ? table.words[address] :
        (params.curveMode == 0u ? inputs.words[address] : params.baseWords[address]);
    return (word >> (8u * (byteIndex & 3u))) & 255u;
}
Fe feFromBytes(uint index, uint start, bool fromTable) {
    uint a[32];
    for (uint i = 0u; i < 32u; ++i)
        a[i] = sourceByte(index, start + i, fromTable);
    Fe r;
    r.n[0] = a[31] | (a[30] << 8) | (a[29] << 16) | ((a[28] & 3u) << 24);
    r.n[1] = ((a[28] >> 2) & 63u) | (a[27] << 6) | (a[26] << 14) | ((a[25] & 15u) << 22);
    r.n[2] = ((a[25] >> 4) & 15u) | (a[24] << 4) | (a[23] << 12) | ((a[22] & 63u) << 20);
    r.n[3] = ((a[22] >> 6) & 3u) | (a[21] << 2) | (a[20] << 10) | (a[19] << 18);
    r.n[4] = a[18] | (a[17] << 8) | (a[16] << 16) | ((a[15] & 3u) << 24);
    r.n[5] = ((a[15] >> 2) & 63u) | (a[14] << 6) | (a[13] << 14) | ((a[12] & 15u) << 22);
    r.n[6] = ((a[12] >> 4) & 15u) | (a[11] << 4) | (a[10] << 12) | ((a[9] & 63u) << 20);
    r.n[7] = ((a[9] >> 6) & 3u) | (a[8] << 2) | (a[7] << 10) | (a[6] << 18);
    r.n[8] = a[5] | (a[4] << 8) | (a[3] << 16) | ((a[2] & 3u) << 24);
    r.n[9] = ((a[2] >> 2) & 63u) | (a[1] << 6) | (a[0] << 14);
    return r;
}
void feToBytes(Fe a, out uint bytes[32]) {
    uint words[8];
    words[0] = (a.n[9] << 10) | (a.n[8] >> 16);
    words[1] = (a.n[8] << 16) | (a.n[7] >> 10);
    words[2] = (a.n[7] << 22) | (a.n[6] >> 4);
    words[3] = (a.n[6] << 28) | (a.n[5] << 2) | (a.n[4] >> 24);
    words[4] = (a.n[4] << 8) | (a.n[3] >> 18);
    words[5] = (a.n[3] << 14) | (a.n[2] >> 12);
    words[6] = (a.n[2] << 20) | (a.n[1] >> 6);
    words[7] = (a.n[1] << 26) | a.n[0];
    for (int i = 0; i < 8; ++i) {
        bytes[i * 4] = (words[i] >> 24) & 255u;
        bytes[i * 4 + 1] = (words[i] >> 16) & 255u;
        bytes[i * 4 + 2] = (words[i] >> 8) & 255u;
        bytes[i * 4 + 3] = words[i] & 255u;
    }
}

#endif

// Unified mixed addition from the same libsecp256k1-derived formula as the
// resident OpenCL curve stage; handles P == G without a separate double path.
Gej gejAddGe(Gej a, Ge b) {
    Fe zz = feSqr(a.z);
    Fe u1 = a.x;
    Fe u2 = feMul(b.x, zz);
    Fe s1 = a.y;
    Fe s2 = feMul(feMul(b.y, zz), a.z);
    Fe t = feAdd(u1, u2);
    Fe m = feAdd(s1, s2);
    Fe rr = feAdd(feSqr(t), feMul(u1, feNegate(u2, 1u)));
    bool degenerate = feZero(m);
    Fe rrAlt = feMulInt(s1, 2u);
    Fe mAlt = feAdd(feNegate(u2, 1u), u1);
    if (!degenerate) { rrAlt = rr; mAlt = m; }
    Fe n = feSqr(mAlt);
    Fe q = feMul(feNegate(t, 5u), n);
    n = feSqr(n);
    if (degenerate) n = m;
    t = feSqr(rrAlt);
    Gej r;
    r.z = feMul(a.z, mAlt);
    t = feAdd(t, q);
    r.x = t;
    t = feMulInt(t, 2u);
    t = feAdd(t, q);
    t = feMul(t, rrAlt);
    t = feAdd(t, n);
    r.y = feHalf(feNegate(t, 6u));
    if (a.inf) { r.x = b.x; r.y = b.y; r.z = feInt(1u); }
    r.inf = feZero(r.z);
    return r;
}

Gej computePoint(uint gid, uint mode) {
    Gej point;
    uint baseIndex = mode == 0u ? gid : 0u;
    point.x = feFromBytes(baseIndex, 0u, false);
    point.y = feFromBytes(baseIndex, 32u, false);
    point.z = feInt(1u);
    point.inf = false;
    if (mode == 0u) {
        Ge generator;
        generator.x = feFromBytes(0u, 0u, false);
        generator.y = feFromBytes(0u, 32u, false);
        generator.inf = false;
        point = gejAddGe(point, generator);
    } else {
        uint offset = params.offsetBase + gid;
        for (uint w = 0u; w < 3u; ++w) {
            uint digit = (offset >> (w * 8u)) & 255u;
            if (digit != 0u) {
                uint tableIndex = w * 256u + digit;
                Ge add;
                add.x = feFromBytes(tableIndex, 0u, true);
                add.y = feFromBytes(tableIndex, 32u, true);
                add.inf = false;
                point = gejAddGe(point, add);
            }
        }
    }
    return point;
}

void writePoint(uint gid, Gej point, Fe zi) {
    Fe zi2 = feSqr(zi);
    Fe x = feNormalize(feMul(point.x, zi2));
    Fe y = feNormalize(feMul(point.y, feMul(zi, zi2)));
    uint xb[32], yb[32];
    feToBytes(x, xb);
    feToBytes(y, yb);
    for (uint i = 0u; i < 16u; ++i) {
        uint p = i * 4u;
        uint b0 = p < 32u ? xb[p] : yb[p - 32u];
        uint b1 = p < 32u ? xb[p + 1u] : yb[p + 1u - 32u];
        uint b2 = p < 32u ? xb[p + 2u] : yb[p + 2u - 32u];
        uint b3 = p < 32u ? xb[p + 3u] : yb[p + 3u - 32u];
        publics.words[gid * 16u + i] = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
    }
}

void writeProjective(uint gid, Gej point) {
    // Struct-of-arrays layout: neighbouring affine work-items read the same
    // limb from neighbouring keys, instead of striding by all 30 limbs of a
    // Jacobian point.  The current dispatch count is the plane stride.
    for (uint i = 0u; i < FIELD_LIMBS; ++i) projectives.words[i * params.count + gid] = point.x.n[i];
    for (uint i = 0u; i < FIELD_LIMBS; ++i) projectives.words[(FIELD_LIMBS + i) * params.count + gid] = point.y.n[i];
    for (uint i = 0u; i < FIELD_LIMBS; ++i) projectives.words[(2u * FIELD_LIMBS + i) * params.count + gid] = point.z.n[i];
}

Fe loadProjective(uint gid, uint field) {
    Fe value;
    for (uint i = 0u; i < FIELD_LIMBS; ++i)
        value.n[i] = projectives.words[(field * FIELD_LIMBS + i) * params.count + gid];
    return value;
}

#if VULKAN_AFFINE
// The RX OpenCL A/B favored four points per inversion; the eight-point
// variant remains available for a target-specific comparison. Reload X/Y only
// during the backward pass so their limbs do not stay live while the prefix
// products and inversion chain are evaluated.
void affineEmit(uint gid, Fe zi, out Fe zOut) {
    Gej point;
    point.x = loadProjective(gid, 0u);
    point.y = loadProjective(gid, 1u);
    point.z = loadProjective(gid, 2u);
    point.inf = false;
    zOut = point.z;
    writePoint(gid, point, zi);
}

void affineTail(uint first, uint batchCount) {
    Fe z[VULKAN_AFFINE_BATCH];
    Fe prefix[VULKAN_AFFINE_BATCH];
    for (uint i = 0u; i < batchCount; ++i) {
        z[i] = loadProjective(first + i, 2u);
        prefix[i] = i == 0u ? z[i] : feMul(prefix[i - 1u], z[i]);
    }
    Fe inv = feInv(prefix[batchCount - 1u]);
    for (int i = int(batchCount) - 1; i >= 0; --i) {
        Fe zi = i == 0 ? inv : feMul(inv, prefix[uint(i) - 1u]);
        // Use the already-loaded Z value; emit only reloads the point X/Y.
        Gej point;
        point.x = loadProjective(first + uint(i), 0u);
        point.y = loadProjective(first + uint(i), 1u);
        point.z = z[uint(i)];
        point.inf = false;
        writePoint(first + uint(i), point, zi);
        if (i > 0) inv = feMul(inv, z[uint(i)]);
    }
}

void affineBatch() {
    uint first = gl_GlobalInvocationID.x * uint(VULKAN_AFFINE_BATCH);
    if (first >= params.count) return;
    uint batchCount = min(uint(VULKAN_AFFINE_BATCH), params.count - first);
    if (batchCount != uint(VULKAN_AFFINE_BATCH)) {
        affineTail(first, batchCount);
        return;
    }
#if VULKAN_AFFINE_BATCH == 8
    Fe p0 = loadProjective(first, 2u);
    Fe z, p1, p2, p3, p4, p5, p6, product, inverse, zi;
    z = loadProjective(first + 1u, 2u); p1 = feMul(p0, z);
    z = loadProjective(first + 2u, 2u); p2 = feMul(p1, z);
    z = loadProjective(first + 3u, 2u); p3 = feMul(p2, z);
    z = loadProjective(first + 4u, 2u); p4 = feMul(p3, z);
    z = loadProjective(first + 5u, 2u); p5 = feMul(p4, z);
    z = loadProjective(first + 6u, 2u); p6 = feMul(p5, z);
    z = loadProjective(first + 7u, 2u); product = feMul(p6, z);
    inverse = feInv(product);
    zi = feMul(inverse, p6); affineEmit(first + 7u, zi, z);
    inverse = feMul(inverse, z);
    zi = feMul(inverse, p5); affineEmit(first + 6u, zi, z);
    inverse = feMul(inverse, z);
    zi = feMul(inverse, p4); affineEmit(first + 5u, zi, z);
    inverse = feMul(inverse, z);
    zi = feMul(inverse, p3); affineEmit(first + 4u, zi, z);
    inverse = feMul(inverse, z);
    zi = feMul(inverse, p2); affineEmit(first + 3u, zi, z);
    inverse = feMul(inverse, z);
    zi = feMul(inverse, p1); affineEmit(first + 2u, zi, z);
    inverse = feMul(inverse, z);
    zi = feMul(inverse, p0); affineEmit(first + 1u, zi, z);
    inverse = feMul(inverse, z);
    affineEmit(first, inverse, z);
#else
    Fe z0 = loadProjective(first, 2u);
    Fe z1 = loadProjective(first + 1u, 2u);
    Fe z2 = loadProjective(first + 2u, 2u);
    Fe z3 = loadProjective(first + 3u, 2u);
    Fe p01 = feMul(z0, z1);
    Fe p012 = feMul(p01, z2);
    Fe product = feMul(p012, z3);
    Fe inverse = feInv(product), t, zi;
    zi = feMul(inverse, p012); affineEmit(first + 3u, zi, z3);
    t = feMul(inverse, z3);
    zi = feMul(t, p01); affineEmit(first + 2u, zi, z2);
    t = feMul(t, z2);
    zi = feMul(t, z0); affineEmit(first + 1u, zi, z1);
    zi = feMul(t, z1); affineEmit(first, zi, z0);
#endif
}
#endif

void main() {
#if VULKAN_AFFINE
    affineBatch();
    return;
#else
    uint invocation = gl_GlobalInvocationID.x;
#if VULKAN_BATCH4
    if (params.curveMode == 2u) {
        uint first = invocation * 4u;
        if (first >= params.count) return;
        uint batchCount = min(4u, params.count - first);
        Gej points[4];
#if !VULKAN_PROJECTIVE
        Fe prefix[4];
#endif
        // The four scalars are consecutive. Build the first point from the
        // offset table only once, then walk +G in Jacobian coordinates on the
        // GPU. Recomputing each point independently needs up to 12 table
        // additions per batch; this path needs at most 3 table additions
        // plus 3 fixed-generator additions. The affine batch inversion below
        // remains unchanged.
        Gej current = computePoint(first, 2u);
        Ge generator;
        generator.x = feFromBytes(1u, 0u, true);
        generator.y = feFromBytes(1u, 32u, true);
        generator.inf = false;
        for (uint i = 0u; i < batchCount; ++i) {
            points[i] = current;
#if !VULKAN_PROJECTIVE
            if (i == 0u) prefix[i] = points[i].z;
            else prefix[i] = feMul(prefix[i - 1u], points[i].z);
#endif
            if (i + 1u < batchCount) current = gejAddGe(current, generator);
        }
#if VULKAN_PROJECTIVE
        for (uint i = 0u; i < batchCount; ++i)
            writeProjective(first + i, points[i]);
        return;
#else
        // inv = 1 / product(Z[0..batchCount-1]). Walk backward to derive every
        // 1/Z[i] with one field inversion and 2*(batchCount-1) multiplications.
        Fe inv = feInv(prefix[batchCount - 1u]);
        for (int i = int(batchCount) - 1; i >= 0; --i) {
            Fe zi;
            if (i == 0) zi = inv;
            else zi = feMul(inv, prefix[i - 1]);
            if (i > 0) inv = feMul(inv, points[i].z);
            writePoint(first + uint(i), points[i], zi);
        }
        return;
#endif
    }
#endif
    if (invocation >= params.count) return;
    Gej point = computePoint(invocation, params.curveMode);
#if VULKAN_PROJECTIVE
    writeProjective(invocation, point);
#else
    writePoint(invocation, point, feInv(point.z));
#endif
#endif
}
