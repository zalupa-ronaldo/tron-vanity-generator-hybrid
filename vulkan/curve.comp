// Native Vulkan secp256k1 mixed point addition. Modes 0/1 retain the
// one-key reference path. Mode 2 computes four keys per invocation and uses
// one Montgomery batch inversion for their four Jacobian Z coordinates.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) writeonly buffer PublicKeys { uint words[]; } publics;
// Kept for the deterministic P+G stage test. Production mode 1 uses the
// push-constant base point below, so it does not read this buffer per key.
layout(std430, set = 0, binding = 6) readonly buffer InputPoints { uint words[]; } inputs;
// The production curve variant leaves points in Jacobian form.  The affine
// variant of this source consumes the same binding and converts groups of
// points with one field inversion.  Keeping the binding in the common shader
// lets the test-only affine curve path retain its old ABI.
layout(std430, set = 0, binding = 5) buffer ProjectivePoints { uint words[]; } projectives;
layout(std430, set = 0, binding = 7) readonly buffer OffsetTable { uint words[]; } table;
layout(push_constant) uniform Params {
    uint count;
    uint dfaOffset;
    uint outStartOffset;
    uint outLenOffset;
    uint outIdsOffset;
    uint curveMode;
    uint offsetBase;
    uint ringMode;
    uint ringCapacity;
    uint recordBase;
    uint baseWords[16];
} params;

#ifdef VULKAN_FIELD8_MODE
struct Fe { uint n[8]; };
#else
struct Fe { uint n[10]; };
#endif
struct Ge { Fe x, y; bool inf; };
struct Gej { Fe x, y, z; bool inf; };
