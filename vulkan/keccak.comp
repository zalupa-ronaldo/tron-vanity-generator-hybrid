#version 450
#extension GL_ARB_gpu_shader_int64 : require

// First production-shaped Vulkan stage: 64-byte secp256k1 public key (X||Y)
// to 21-byte TRON payload. Input is 16 little-endian u32 words per key;
// output is six little-endian u32 words, with three zero padding bytes.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer PublicKeys {
    uint words[];
} publicKeys;
layout(std430, set = 0, binding = 1) writeonly buffer Payloads {
    uint words[];
} payloads;
layout(push_constant) uniform Params {
    uint count;
} params;

const uint64_t RC[24] = uint64_t[24](
    0x0000000000000001ul, 0x0000000000008082ul, 0x800000000000808aul,
    0x8000000080008000ul, 0x000000000000808bul, 0x0000000080000001ul,
    0x8000000080008081ul, 0x8000000000008009ul, 0x000000000000008aul,
    0x0000000000000088ul, 0x0000000080008009ul, 0x000000008000000aul,
    0x000000008000808bul, 0x800000000000008bul, 0x8000000000008089ul,
    0x8000000000008003ul, 0x8000000000008002ul, 0x8000000000000080ul,
    0x000000000000800aul, 0x800000008000000aul, 0x8000000080008081ul,
    0x8000000000008080ul, 0x0000000080000001ul, 0x8000000080008008ul
);
const int RHO[25] = int[25](
    0, 1, 62, 28, 27, 36, 44, 6, 55, 20, 3, 10, 43, 25, 39,
    41, 45, 15, 21, 8, 18, 2, 61, 56, 14
);

uint64_t rotl64(uint64_t x, int bits) {
    return bits == 0 ? x : ((x << bits) | (x >> (64 - bits)));
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= params.count) return;

    uint64_t s[25];
    for (int i = 0; i < 8; ++i) {
        uint lo = publicKeys.words[gid * 16u + uint(i * 2)];
        uint hi = publicKeys.words[gid * 16u + uint(i * 2 + 1)];
        s[i] = uint64_t(lo) | (uint64_t(hi) << 32);
    }
    for (int i = 8; i < 25; ++i) s[i] = 0ul;
    s[8] = 0x01ul;                 // Keccak-256 pad after 64 input bytes.
    s[16] = 0x8000000000000000ul; // Last byte of the 136-byte rate.

    for (int round = 0; round < 24; ++round) {
        uint64_t c[5], d[5], b[25];
        for (int x = 0; x < 5; ++x)
            c[x] = s[x] ^ s[x + 5] ^ s[x + 10] ^ s[x + 15] ^ s[x + 20];
        for (int x = 0; x < 5; ++x)
            d[x] = c[(x + 4) % 5] ^ rotl64(c[(x + 1) % 5], 1);
        for (int x = 0; x < 5; ++x)
            for (int y = 0; y < 5; ++y)
                s[x + 5 * y] ^= d[x];
        for (int x = 0; x < 5; ++x)
            for (int y = 0; y < 5; ++y)
                b[y + 5 * ((2 * x + 3 * y) % 5)] = rotl64(s[x + 5 * y], RHO[x + 5 * y]);
        for (int x = 0; x < 5; ++x)
            for (int y = 0; y < 5; ++y)
                s[x + 5 * y] = b[x + 5 * y] ^
                    ((~b[(x + 1) % 5 + 5 * y]) & b[(x + 2) % 5 + 5 * y]);
        s[0] ^= RC[round];
    }

    uint packed[6];
    for (int i = 0; i < 6; ++i) packed[i] = 0u;
    for (int i = 0; i < 21; ++i) {
        int hashByte = i + 11;
        uint value = i == 0 ? 0x41u :
            uint((s[hashByte / 8] >> (8 * (hashByte % 8))) & 0xfful);
        packed[i / 4] |= value << (8 * (i % 4));
    }
    for (int i = 0; i < 6; ++i)
        payloads.words[gid * 6u + uint(i)] = packed[i];
}
